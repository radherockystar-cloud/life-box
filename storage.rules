// Firebase Console -> Storage -> Rules me ye paste karke Publish karo.
// Har user sirf apna folder (users/<apna uid>/...) padh / likh sakta hai. Baaki sab band.
rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    match /users/{uid}/{allPaths=**} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }
  }
}
